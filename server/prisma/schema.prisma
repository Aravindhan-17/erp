// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  sessions AdminSession[]
}

model AdminSession {
  id          String   @id @default(uuid())
  adminUserId String
  hashedToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String
  firstName    String
  lastName     String

  dob           DateTime?
  gender        Gender?
  profileImage  String?
  lifetimeSpend Decimal           @default(0.00)
  ordersCount   Int               @default(0)
  isActive      Boolean           @default(true)
  lastLogin     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      CustomerSession[]
  addresses     CustomerAddress[]
  wallet        CustomerWallet?
  orders        Order[]
  tickets       Ticket[]
}

model CustomerSession {
  id          String   @id @default(uuid())
  customerId  String
  hashedToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id                   String   @id @default(uuid())
  customerId           String
  name                 String
  fullName             String
  phone                String
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String
  zip                  String
  country              String
  deliveryInstructions String?
  isDefaultShipping    Boolean  @default(false)
  isDefaultBilling     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerWallet {
  id         String   @id @default(uuid())
  customerId String   @unique
  balance    Decimal  @default(0.00)
  currency   String   @default("INR")
  updatedAt  DateTime @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

enum TransactionType {
  CREDIT // Adding money
  DEBIT // Removing money
}

model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String
  amount      Decimal
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  customerId  String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @default(0.00)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model Ticket {
  id         String         @id @default(uuid())
  customerId String
  subject    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(LOW)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

enum CategoryStatus {
  ACTIVE
  UPCOMING
  INACTIVE
}

enum Industry {
  RETAIL
  WHOLESALE
  B2B
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  parentId    String? // Supports deep nesting
  bannerUrl   String? // Promotional banner image URL
  imageUrl    String? // Category icon or small image
  status      CategoryStatus @default(ACTIVE)
  industry    Industry       @default(RETAIL)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  categoryId       String
  brand            String?
  price            Decimal
  salePrice        Decimal?
  stock            Int           @default(0)
  images           String[]
  status           ProductStatus @default(ACTIVE)

  // Flash Deal Specific Fields
  isFlashDeal        Boolean   @default(false)
  flashDealStartTime DateTime?
  flashDealEndTime   DateTime?
  registrationFee    Decimal?
  minOrderValue      Decimal?
  maxQuantityPerUser Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
